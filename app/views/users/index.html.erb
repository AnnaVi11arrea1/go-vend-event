<div style="background-color: #000; color: #fff;">
  <!-- Hero Section -->
  <section class="hero-section" style="padding: 60px 20px; text-align: center;">
    <div style="max-width: 900px; margin: 0 auto;">
      <div style="font-size: 2.5rem; font-weight: 700; margin-bottom: 10px; color: #fff;">Welcome to 
      <div style="font-family: 'Trade Winds', cursive; font-size: 4rem;">
        <div class="d-flex justify-content-center">
          <div style="color: lime;">go</div>
          <div style="color: rgb(170, 50, 255);">Vend</div>
        </div>
      </div>
    </div>
      <p style="font-size: 1.3rem; margin-bottom: 40px; font-weight: 500;">Increase sales and stay organized</p>

      <!-- Cat above Sign Up | Cube above Browse Events -->
      <div style="display: flex; gap: 60px; align-items: flex-end; justify-content: center; margin: 60px auto 40px; flex-wrap: wrap; max-width: 1000px; padding: 0 20px;">
        <!-- Sign Up column -->
        <div style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
          <%= image_tag "favicon.png", alt:"goVend mascot", class:"img-fluid cat", style: "max-width: 140px; height: auto;" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "sign_up_btn", style: "text-decoration: none; color: #000;" %>
        </div>

        <!-- Browse Events column -->
        <div style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
          <div class="cube-gallery-wrapper py-3">
            <input class="radio-button" type="radio" name="cube-gallery" checked/>
            <input class="radio-button" type="radio" name="cube-gallery"/>
            <input class="radio-button" type="radio" name="cube-gallery"/>
            <input class="radio-button" type="radio" name="cube-gallery"/>
            <input class="radio-button" type="radio" name="cube-gallery"/>
            <input class="radio-button" type="radio" name="cube-gallery"/>
            <div class="cube-container mt-4">
              <div class="cube">
                <% upcoming_events = Event.where('started_at > ?', Date.today).order(:started_at).limit(6) %>
                <% upcoming_events.each do |event| %>
                  <div class="cube-side d-flex justify-content-center align-items-center">
                    <div class="text-center p-3">
                      <div class="mb-2">
                        <% if event.photo.present? %>
                          <%= image_tag url_for(event.photo.url), class: "img-fluid rounded", style: "max-height: 100px; width: auto;", alt: "event photo" %>
                        <% else %>
                          <%= image_tag "bulb.png", class: "img-fluid", style: "max-height: 100px; width: auto;", alt: "default photo" %>
                        <% end %>
                      </div>
                      <h2 class="h5 mb-1 px-2"><%= event.name %></h2>
                      <h4 class="cube-text h6 mb-2"><%= event.started_at.strftime("%A, %B %d, %Y") %></h4>
                      <p class="small mb-0">Explore more events when you sign up.</p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          <%= link_to "Browse Events", events_path, class: "sign_up_btn", style: "text-decoration: none; color: #000;" %>
        </div>
      </div>
      <p style="font-size: 1.1rem; color: #ddd; line-height: 1.6; margin-bottom: 20px; max-width: 600px; margin-left: auto; margin-right: auto;">
        Find events. Apply to them. Stay organized. Track payments. Never double-book again. Made with love by vendors, for vendors and events.
      </p>
    </div>
  </section>

  <!-- User Types Section -->
  <section style="padding: 60px 20px; max-width: 1200px; margin: 0 auto;">
    <h2 style="text-align: center; font-size: 2rem; margin-bottom: 50px; color: #fff; font-weight: 600;">Who Is goVend For?</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
      <!-- Vendors Card -->
      <div class="vendor-coordinator-card" style="background: linear-gradient(135deg, rgba(61, 0, 166, 0.3) 0%, rgba(0, 53, 213, 0.3) 100%); border: 1px solid rgba(148, 91, 255, 0.3); border-radius: 15px; padding: 40px 25px; transition: all 0.3s;">
        <h3 style="font-size: 1.5rem; color: rgb(255, 246, 167); margin-bottom: 20px; font-weight: 600;">For Vendors</h3>
        <p style="color: #ddd; line-height: 1.7; margin-bottom: 25px;">
          Search for events, apply instantly, and manage everything in one place. Track your applications, payment status, and event data all from your dashboard.
        </p>
        <ul style="list-style: none; padding: 0; color: #ddd; line-height: 1.8;">
          <li style="margin-bottom: 12px;">✓ Find events that match your business</li>
          <li style="margin-bottom: 12px;">✓ One-click applications</li>
          <li style="margin-bottom: 12px;">✓ Avoid double-booking</li>
          <li style="margin-bottom: 12px;">✓ Track sales and expenses</li>
          <li>✓ Showcase your business</li>
        </ul>
      </div>

      <!-- Event Coordinators Card -->
      <div class="vendor-coordinator-card" style="background: linear-gradient(135deg, rgba(61, 0, 166, 0.3) 0%, rgba(0, 53, 213, 0.3) 100%); border: 1px solid rgba(148, 91, 255, 0.3); border-radius: 15px; padding: 40px 25px; transition: all 0.3s;">
        <h3 style="font-size: 1.5rem; color: rgb(255, 246, 167); margin-bottom: 20px; font-weight: 600;">For Event Coordinators</h3>
        <p style="color: #ddd; line-height: 1.7; margin-bottom: 25px;">
          Post your events and discover amazing vendors. Build your vendor network and keep patrons excited with fresh, trending businesses.
        </p>
        <ul style="list-style: none; padding: 0; color: #ddd; line-height: 1.8;">
          <li style="margin-bottom: 12px;">✓ Post events in minutes</li>
          <li style="margin-bottom: 12px;">✓ Find quality vendors</li>
          <li style="margin-bottom: 12px;">✓ See vendor profiles & portfolios</li>
          <li style="margin-bottom: 12px;">✓ Manage applications</li>
          <li>✓ Build recurring events</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section style="padding: 60px 20px; background: linear-gradient(135deg, rgba(61, 0, 166, 0.1) 0%, rgba(0, 53, 213, 0.1) 100%); margin: 60px 0;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h2 style="text-align: center; font-size: 2rem; margin-bottom: 50px; color: #fff; font-weight: 600;">Why Choose goVend?</h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 25px;">
        <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(148, 91, 255, 0.2); border-radius: 12px; padding: 30px; text-align: center;">
          <div style="font-size: 2.5rem; margin-bottom: 15px;">⚡</div>
          <h4 style="color: rgb(255, 246, 167); margin-bottom: 12px; font-weight: 600;">Quick Setup</h4>
          <p style="color: #ccc; font-size: 0.95rem;">Create an account and start using goVend in less than 5 minutes.</p>
        </div>

        <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(148, 91, 255, 0.2); border-radius: 12px; padding: 30px; text-align: center;">
          <div style="font-size: 2.5rem; margin-bottom: 15px;">🎯</div>
          <h4 style="color: rgb(255, 246, 167); margin-bottom: 12px; font-weight: 600;">Easy Discovery</h4>
          <p style="color: #ccc; font-size: 0.95rem;">Search events and vendors with powerful filters. Find exactly what you need.</p>
        </div>

        <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(148, 91, 255, 0.2); border-radius: 12px; padding: 30px; text-align: center;">
          <div style="font-size: 2.5rem; margin-bottom: 15px;">📊</div>
          <h4 style="color: rgb(255, 246, 167); margin-bottom: 12px; font-weight: 600;">Track Everything</h4>
          <p style="color: #ccc; font-size: 0.95rem;">Monitor applications, sales, expenses, and event performance in one dashboard.</p>
        </div>

        <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(148, 91, 255, 0.2); border-radius: 12px; padding: 30px; text-align: center;">
          <div style="font-size: 2.5rem; margin-bottom: 15px;">🚀</div>
          <h4 style="color: rgb(255, 246, 167); margin-bottom: 12px; font-weight: 600;">Grow Your Business</h4>
          <p style="color: #ccc; font-size: 0.95rem;">Reach more customers and build your vendor network with goVend.</p>
        </div>

        <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(148, 91, 255, 0.2); border-radius: 12px; padding: 30px; text-align: center;">
          <div style="font-size: 2.5rem; margin-bottom: 15px;">🛡️</div>
          <h4 style="color: rgb(255, 246, 167); margin-bottom: 12px; font-weight: 600;">Trusted Community</h4>
          <p style="color: #ccc; font-size: 0.95rem;">Connect with vetted vendors and organizers in a safe marketplace.</p>
        </div>

        <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(148, 91, 255, 0.2); border-radius: 12px; padding: 30px; text-align: center;">
          <div style="font-size: 2.5rem; margin-bottom: 15px;">❤️</div>
          <h4 style="color: rgb(255, 246, 167); margin-bottom: 12px; font-weight: 600;">Built by a Vendor</h4>
          <p style="color: #ccc; font-size: 0.95rem;">Made with love by people who understand your challenges.</p>
        </div>
      </div>
    </div>
  </section>

</div>
