<div class="container py-4">
  <h1 class="darktitle">Help Tickets</h1>

  <div class="mb-3">
    <%= link_to "Submit New Ticket", new_ticket_path, class: "event_btn" %>
  </div>

  <% if @tickets.any? %>
    <div class="darkcard p-3">
      <% @tickets.each do |ticket| %>
        <div class="mb-3 pb-3" style="border-bottom: 1px solid rgba(255,255,255,0.2);">
          <h5><%= link_to ticket.subject, ticket_path(ticket) %></h5>
          <p class="mb-1"><strong>Status:</strong> <%= ticket.status.humanize %></p>
          <p class="mb-1"><strong>Submitted:</strong> <%= ticket.created_at.strftime("%b %d, %Y %H:%M") %></p>
          <% if ticket.responded_at.present? %>
            <p class="mb-0"><strong>Last response:</strong> <%= ticket.responded_at.strftime("%b %d, %Y %H:%M") %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="darkcard p-3">
      <p class="mb-0">No tickets yet. Submit a help ticket if you need support.</p>
    </div>
  <% end %>
</div>
