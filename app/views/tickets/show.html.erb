<div class="container py-4">
  <h1 class="darktitle">Ticket Details</h1>

  <div class="darkcard p-4 mb-3">
    <h4><%= @ticket.subject %></h4>
    <p><strong>Status:</strong> <%= @ticket.status.humanize %></p>
    <p><strong>Submitted:</strong> <%= @ticket.created_at.strftime("%b %d, %Y %H:%M") %></p>
    <hr>
    <p style="white-space: pre-wrap;"><%= @ticket.message %></p>
  </div>

  <% if @ticket.admin_response.present? %>
    <div class="darkcard p-4 mb-3">
      <h5>Admin Response</h5>
      <p style="white-space: pre-wrap;"><%= @ticket.admin_response %></p>
      <p class="mb-0">
        <small>
          Responded
          <% if @ticket.responded_by.present? %>
            by <%= @ticket.responded_by.username.presence || @ticket.responded_by.email %>
          <% end %>
          <% if @ticket.responded_at.present? %>
            on <%= @ticket.responded_at.strftime("%b %d, %Y %H:%M") %>
          <% end %>
        </small>
      </p>
    </div>
  <% end %>

  <%= link_to "Back to Tickets", tickets_path, class: "event_btn" %>
</div>
