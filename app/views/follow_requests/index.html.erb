<div class="darkcard intro event-form-shell">
  <div class="darktitle">
    <h2>Follow Requests</h2>
    <p class="event-form-subtitle">Manage your incoming and outgoing requests.</p>
  </div>

  <div class="funcard2 mb-3 p-3">
    <h4>Pending Requests You Received</h4>
    <% if @pending_received_follow_requests.any? %>
      <ul>
        <% @pending_received_follow_requests.each do |follow_request| %>
          <li class="mb-2">
            <strong><%= follow_request.sender.username %></strong>
            <%= button_to "Accept", accept_follow_request_path(follow_request), method: :patch, class: "btn-pri" %>
            <%= button_to "Reject", reject_follow_request_path(follow_request), method: :patch, class: "btn-dang" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No pending incoming requests.</p>
    <% end %>
  </div>

  <div class="funcard2 mb-3 p-3">
    <h4>Pending Requests You Sent</h4>
    <% if @pending_sent_follow_requests.any? %>
      <ul>
        <% @pending_sent_follow_requests.each do |follow_request| %>
          <li class="mb-2">
            <strong><%= follow_request.recipient.username %></strong>
            <span><sup>Pending</sup></span>
            <%= link_to "View", follow_request_path(follow_request), class: "btn-in" %>
            <%= button_to "Cancel", follow_request_path(follow_request), method: :delete, data: { turbo_confirm: "Cancel this request?" }, class: "btn-dang" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No pending outgoing requests.</p>
    <% end %>
  </div>

  <div class="funcard2 p-3">
    <h4>All Request History</h4>
    <% if @received_follow_requests.any? || @sent_follow_requests.any? %>
      <ul>
        <% (@received_follow_requests + @sent_follow_requests).uniq.sort_by(&:created_at).reverse_each do |follow_request| %>
          <li class="mb-1">
            <% if follow_request.sender_id == current_user.id %>
              You -> <%= follow_request.recipient.username %>
            <% else %>
              <%= follow_request.sender.username %> -> You
            <% end %>
            (<%= follow_request.status %>)
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No follow request history yet.</p>
    <% end %>
  </div>
</div>
