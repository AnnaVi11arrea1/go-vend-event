<div class="darkcard">
  <div class="darktitle">
    <sup>Event</sup>
    <div style="font-family: 'Trade Winds', system-ui;"><h1><%= @vendor_event.event.name %></h1></div>
    <div class="col justify-content-around nav-links">
      <div>
        <%= link_to "Return", vendor_events_path, class:"event_btn" %>
      </div>
      <div>
        <%= link_to "Edit Status", edit_vendor_event_path(@vendor_event), class:"btn-pri" %>
      </div>
      <div>
        <%= button_to "Remove", @vendor_event, method: :delete, class: "btn-dang explode",  data: { confirm: "Are you sure you want to delete this event?", 
            data: { turbo: false } } %>
      </div>
    </div>
  </div>
  <div class="d-flex justify-content-center mt-4">
    <% if @vendor_event.event.photo.present?%>
      <%= image_tag @vendor_event.event.photo.url, alt:"profile pic", class:"profile-pic" %>
    <% else %>
      <%= image_tag 'favicon.png', alt:"profile pic", class:"profile-pic" %>
    <% end %>
  </div>

  <div class="d-flex flex-wrap justify-content-center row-gap-20 col-gap-4 mt-4 pb-4">
    <div class="col-3">
        <strong>Description:</strong>
      <%= sanitize(@vendor_event.event.information, tags: %w[p br strong em b i u ul ol li a blockquote h1 h2 h3 h4], attributes: %w[href target rel]) %>
    </div>
    <div class="col-1"></div>
    <div class="col-3">
      <div>
        <strong>Location:</strong>
        <%= @vendor_event.event.address %>
      </div>
      <div>
        <strong>Starts on:</strong>
        <%= @vendor_event.event.started_at.strftime("%B %d, %Y") %>
      </div>
      <% if @vendor_event.event.ends_at.present? %>
        <div>
          <strong>Goes until:</strong>
          <%= @vendor_event.event.ends_at.strftime("%B %d, %Y") %>
        </div>
      <% end %>
    </div>
    <div class="col-1"></div>
    <div class="col-3">
        <strong>Application status:</strong>
        <% if @vendor_event.application_status? %>
          <p><%= @vendor_event.application_status %></p>
        <% else %>
          <p>Not applied</p>
        <% end %>
        <strong>Paid:</strong>
        <% if @vendor_event.paid? %>
          <p>PAID</p>
        <% else %>
          <p>DUE</p>
        <% end %>
     </div>
  </div>
</div> 
<br>

<div class="darkcard">
    <div class="funcard2">
      <div class="darktitle">Notes</div>
      <div class="trix-container">
        <% @note ||= Note.new %>
        <% if @note.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <%= @note.errors.full_messages.to_sentence %>
          </div>
        <% end %>
        <%= form_with(model: [@vendor_event, @note], data: { turbo: false }) do |form| %>
          <%= form.label :content, "Create Note" %><br>
          <%= form.rich_text_area :content %>
          <%= form.submit "Add Note", class: "btn-in" %>
        <% end %>
      </div>
    </div>  
    <div>
      <% @vendor_event.notes.each do |note| %>
        <div class="darkcard3">
          <%= sanitize(note.content) %>
        
          (<%= link_to "Edit", edit_vendor_event_note_path(@vendor_event, note) %> |
          <%= link_to "Delete", vendor_event_note_path(@vendor_event, note), method: :delete, data: { confirm: "Are you sure?" } %> )
          <br>
          <small>
          <strong>Created at:</strong>
          <%= note.created_at.strftime("%B %d, %Y") %>
          </small>
        </div>
      <% end %>
    </div>
  </div>
</div>
