<div>
  <div class="darkcard">
    <h1>Event: <%= @event.name %> </h1>
    <div>Posted by:
      <% if @event.host.photo.present? %>
        <%= image_tag @event.host.photo.url, alt: "profile pic", style:"height:30px; width:auto;" %>  
      <% else %>
        <%= image_tag "favicon.png", alt: "profile pic", style:"height:30px; width:auto;" %>
      <% end %>
      <%= @event.host.username %>
      <% if current_user != @event.host %>
        <% if current_user.leaders.include?(@event.host) %>
          <p><sup>You are following <%= @event.host.username %>.</sup></p>
        <% elsif current_user.sent_follow_requests.pending.exists?(recipient: @event.host) %>
          <p><sup>Follow request sent.</sup></p>
        <% elsif current_user.received_follow_requests.pending.exists?(sender: @event.host) %>
          <%= button_to 'Accept Follow Request', accept_follow_request_path(current_user.received_follow_requests.pending.find_by(sender: @event.host)), method: :patch %>
          <%= button_to 'Reject Follow Request', reject_follow_request_path(current_user.received_follow_requests.pending.find_by(sender: @event.host)), method: :patch %>
        <% else %>
          <%= button_to 'Send Follow Request', user_follow_requests_path(@event.host), method: :post %>
        <% end %>
      <% end %>
    </div>
    <div class="d-flex row">
      <div class="col">
        <div class="d-flex justify-content-center">
          <% if @event.photo.present? %>
            <%= image_tag @event.photo.url, alt:"profile pic", width:"80%", class:"mycard" %>
          <% else %>
            <%= image_tag "favicon.png", alt:"profile pic", width:"200px", class:"rounded-circle" %>
          <% end %>
        </div>
        <div class="d-flex justify-content-center pt-3">
          <% if current_user == @event.host %>
            <p><sup>You host this event.</sup></p>
          <% else %>
            <% existing_vendor_event = current_user.vendor_events.find_by(event_id: @event.id) %>
            <% if existing_vendor_event.present? %>
              <%= button_to "Remove from My Events",
                  vendor_event_path(existing_vendor_event),
                  method: :delete,
                  class: "btn-dang",
                  data: {
                    turbo_confirm: "Are you sure you want to remove this from your events?",
                    confirm: "Are you sure you want to remove this from your events?"
                  } %>
            <% else %>
              <%= form_with model: VendorEvent.new, url: vendor_events_path do |form|%>
                <%= form.hidden_field :event_id, value: @event.id %>
                <%= form.submit 'Add to My Events', class: 'btn-pri' %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="col">
      <% if @event.application_due_at.present? %>
        <p class="card-text">
          <strong>Applications due:</strong>
          <%= @event.application_due_at&.year&.positive? ? @event.application_due_at.strftime("%B %d, %Y") : "N/A" %></p>
      <% end %>
        <p class="card-text">
          <strong>Event Begins:</strong>
          <%= @event.started_at&.year&.positive? ? @event.started_at.strftime("%B %d, %Y") : "Date TBD" %></p>
        <% if @event.ends_at.present? %>
        <p class="card-text">
          <strong>Event Ends:</strong>
          <%= @event.ends_at&.year&.positive? ? @event.ends_at.strftime("%B %d, %Y") : "N/A" %></p>
        <% end %>
        <p class="card-text">
          <strong>Information:</strong>
          <%= sanitize(@event.information, tags: %w[p br strong em b i u ul ol li a blockquote h1 h2 h3 h4], attributes: %w[href target rel]) %>
        </p>
        <p class="card-text">
          <strong>Application link:</strong>
          <% if @event.application_link.present? %>
            <%= link_to @event.application_link, @event.application_link, target: "_blank" %>
          <% elsif @event.contact_email.present? %>
            <%= mail_to @event.contact_email %>
          <% else %>
            <span>Not provided</span>
          <% end %>
        </p>
        <p class="card-text">
          <strong>Tags:</strong>
          <%= @event.tags %></p>
        <p class="card-text">
          <strong>Address:</strong>
          <%= @event.address %></p>
      </div>
    </div>
    <div class="row justify-content-around pt-2">
      <% if @user == @event.host %>
        <%= link_to "Edit this event", edit_event_path(@event), class:"btn-in" %>
        <%= link_to "Destroy this event", @event, method: :delete, class:"btn-in"  %>
      <% end %>
    </div>
  </div>
</div>

<div class="darkcard3">
  <% if @comments.present? %>
    <ul class="list-group list-group-flush">
      <% @comments.each do |comment| %>
        <li id="comment_<%= comment.id %>" class="comment-container">
          <div class="d-flex">
            <%= image_tag "bulb.png", alt: "profile pic", width: "50px", height: "50px" %>
          </div>
          <div class="col">
            <h6 class="mt-0"><%= comment.author.username %></h6>
            <p id="comment-body-<%= comment.id %>"><%= comment.body %></p>
            <% if current_user == comment.author %>
              <div class="d-flex justify-content-between">
                <div id="edit-form-<%= comment.id %>" style="display: none; width: 100%;">
                  <%= form_with(model: [@event, comment], data: { turbo: false }) do |form| %>
                    <%= form.rich_text_area :body, class: "form-control", value: comment.body %>
                    <%= form.submit "Update", class: "btn-in" %>
                  <% end %>
                </div>
                <div>
                  <button id="edit-toggle-<%= comment.id %>" class="btn-in" onclick="showEditForm(<%= comment.id %>)">Edit</button>
                </div>
                <div>
                <%= link_to "Delete", delete_comment_path(comment),  method: :delete, data: { confirm: "Are you sure you want to delete this comment?" }, class: "btn-in" %>
                </div>
              </div>
            <% end %>
            <div class="col">
            <% if comment.created_at != comment.updated_at %>
              <p><small>Edited at: <%= comment.updated_at.strftime("%B %d, %Y") %></small></p>
            <% else %>
              <p><small>Created at: <%= comment.created_at.strftime("%B %d, %Y") %></small></p>
            <% end %>
            </div>
          </div>
        </li>
        <br>
      <% end %>
    </ul> <!-- This should be outside the loop -->
  <% else %>
    <p>No comments found.</p>
  <% end %>
  <!-- Render the comment form -->
  <%= render "comments/form", comment: @event.comments.build %>

</div>

<!-- Similar Events Section -->
<% if @similar_events.present? %>
  <div class="darkcard mt-4">
    <h3 class="mb-3">✨ Similar Events You Might Like</h3>
    <p class="text-muted">Based on location, type, and event details</p>
    
    <div class="row">
      <% @similar_events.each do |similar_event| %>
        <div class="col-md-4 mb-3">
          <div class="card h-100 darkcard3">
            <% if similar_event.photo.present? %>
              <%= image_tag similar_event.photo.url, alt: similar_event.name, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
            <% else %>
              <%= image_tag "favicon.png", alt: similar_event.name, class: "card-img-top p-4", style: "height: 200px; object-fit: contain;" %>
            <% end %>
            
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= similar_event.name %></h5>
              
              <div class="mb-2">
                <small>
                  📍 <%= similar_event.state %><br>
                  📅 <%= similar_event.started_at&.strftime("%B %d, %Y") || 'Date TBD' %>
                </small>
              </div>
              
              <% if similar_event.information.present? %>
                <p class="card-text flex-grow-1" style="font-size: 0.9rem;">
                  <%= truncate(strip_tags(similar_event.information), length: 100) %>
                </p>
              <% end %>
              
              <div class="mt-auto">
                <%= link_to "View Details", event_path(similar_event), class: "btn-pri w-100" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
