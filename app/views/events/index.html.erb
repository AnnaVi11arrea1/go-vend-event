<div id="events" class="darkcard" 
     data-controller="algolia-chat"
     data-algolia-chat-app-id-value="<%= ENV['ALGOLIA_APP_ID'] %>"
     data-algolia-chat-search-key-value="<%= ENV['ALGOLIA_SEARCH_KEY'] %>"
     data-algolia-chat-user-id-value="<%= current_user&.id %>"
     data-algolia-chat-auth-token-value="<%= form_authenticity_token %>"
     data-algolia-chat-session-id-value="<%= session.id %>">
        <p class="d-flex justify-content-center">Find events that match your needs. Click map icons to see quick details.</p>

  <!-- Algolia Chat Floating Button -->
  <button class="chat-toggle-btn" data-action="click->algolia-chat#toggle" data-algolia-chat-target="button">
    <i class="fas fa-robot"></i> Ask AI
  </button>

  <div id="chat-window" class="chat-window d-none" data-algolia-chat-target="container">
    <div class="chat-header">
      <div class="header-main">
        <span>AI Search Assistant</span>
        <div class="header-actions">
          <button class="maximize-btn" data-action="click->algolia-chat#maximize">
            <i class="fa fa-expand"></i>
          </button>
          <button class="btn-close btn-close-white" data-action="click->algolia-chat#toggle"></button>
        </div>
      </div>
      
      <div class="chat-toolbar">
        <button class="toolbar-btn" data-action="click->algolia-chat#resetChat" title="Clear Chat">
          <i class="fa fa-trash"></i> <span>Clear</span>
        </button>
        <button class="toolbar-btn" data-action="click->algolia-chat#copyChat" title="Copy Last Response">
          <i class="fa fa-copy"></i> <span>Copy</span>
        </button>
        <button class="toolbar-btn" data-action="click->algolia-chat#submitChat" title="Send Message">
          <i class="fa fa-paper-plane"></i> <span>Send</span>
        </button>
      </div>
    </div>
    <div id="chat-widget-container"></div>
  </div>

  <div>
    <div id="map" 
         style='height: 400px;'
         data-controller="map"
         data-map-token-value="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>"
         data-map-events-value="<%= @events.to_json(only: [:address, :name], methods: [:photo_url]) %>"
         data-map-default-photo-url-value="<%= asset_path('bulb.png') %>">
    </div>
  </div>

  <div class="intro d-flex justify-content-center">
    <%= search_form_for @q do |f| %>
      <div class="search">
        <br>
        <div>
          <%= f.label :name_cont %>
          <%= f.text_field :name_cont %>
        </div>
        <div>
          <%= f.label :city_cont, "City / Metro Area" %>
          <%= f.text_field :city_cont %>
        </div>
        <div>
          <%= f.label :state_cont, "State" %>
          <%= f.text_field :state_cont %>
        </div>
        <div>
          <%= f.label :started_at_gteq, "On or after " %>
          <%= f.date_field :started_at_gteq %>
        </div>
        <div class="flex row justify-content-around">
        <div>
          <%= f.submit class:"btn-in" %>
        </div>
        <div class="btn-dang">
          <%= link_to "Clear", events_path %>
        </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex flex-wrap justify-content-center">
    <% if @events.present? %>
      <% @events.each do |event| %>
        <div class="feed-box">
          <div class="col">
            <div class="d-flex flex-column justify-content-center m-3 pt-4">
              <sup><i>Event Name</i></sup>
              <div style="border-top: .5px solid rgb(0, 255, 0); border-radius: 12px; padding: 8px; background-color: transparent; font-family: 'Trade Winds', sans-serif; font-size: 18px;">
                <h4> <%= event.name %></h4>
              </div>
            </div>
            <div class="col d-flex justify-content-center mt-4">
              <% if event.photo.present?%>
                <%= image_tag event.photo.url, alt:"profile pic", class:"profile-pic" %>
              <% else %>
                <%= image_tag 'favicon.png', alt:"profile pic", class:"profile-pic" %>
              <% end %>
            </div>
            <div class="col">
              <p class="card-text"><small>
                <strong>Where:</strong>
                <%= event.address %></small></p>
              <p class="card-text"><small><strong>When:</strong>
                <%= event.started_at&.year&.positive? ? event.started_at.strftime("%B %d, %Y") : "Date TBD" %></small></p>
            </div>
          </div>
          <div class="pt-5">
              <%= link_to "Show this event", event, class:"event_btn" %>
          </div>
        </div>
      <% end %>
      <% else %>
        <p>No events found.</p>
    <% end %>
  </div>
  <div class="d-flex justify-content-around p-3">
    
<%= pagination_links(@current_page, @total_pages) %>
  </div>
</div>
