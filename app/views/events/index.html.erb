<div id="events" class="darkcard">
        <p class="d-flex justify-content-center">Find events that match your needs. Click map icons to see quick details.</p>

  <div>
    <div id="map" 
         style='height: 400px;'
         data-controller="map"
         data-map-token-value="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>"
         data-map-events-value="<%= @events.to_json(only: [:address, :name], methods: [:photo_url]) %>"
         data-map-default-photo-url-value="<%= asset_path('bulb.png') %>">
    </div>
  </div>

  <div class="intro d-flex justify-content-center">
    <%= search_form_for @q do |f| %>
      <div class="search">
        <br>
        <div>
          <%= f.label :name_cont %>
          <%= f.text_field :name_cont %>
        </div>
        <div>
          <%= f.label :started_at_gteq, "On or after " %>
          <%= f.date_field :started_at_gteq %>
        </div>
        <div class="flex row justify-content-around">
        <div>
          <%= f.submit class:"btn-in" %>
        </div>
        <div class="btn-dang">
          <%= link_to "Clear", events_path %>
        </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="d-flex flex-wrap justify-content-center">
    <% if @events.present? %>
      <% @events.each do |event| %>
        <div class="feed-box">
          <div class="col">
            <div class="d-flex flex-column justify-content-center m-4">
              <p>Event Name:</p>
              <div>
                <h4> <%= event.name %></h4>
              </div>
            </div>
            <div class="col d-flex justify-content-center mt-4">
              <% if event.photo.present?%>
                <%= image_tag event.photo.url, alt:"profile pic", class:"profile-pic" %>
              <% else %>
                <%= image_tag 'favicon.png', alt:"profile pic", class:"profile-pic" %>
              <% end %>
            </div>
            <div class="col">
              <p class="card-text">
                <strong>Where:</strong>
                <%= event.address %></p>
              <p class="card-text"><strong>When:</strong>
                <%= event.started_at.strftime("%B %d, %Y") %></p>
            </div>
          </div>
          <div class="pt-5">
              <%= link_to "Show this event", event, class:"event_btn" %>
          </div>
        </div>
      <% end %>
      <% else %>
        <p>No events found.</p>
    <% end %>
  </div>
  <div class="d-flex justify-content-around p-3">
    
<%= pagination_links(@current_page, @total_pages) %>
  </div>
</div>
