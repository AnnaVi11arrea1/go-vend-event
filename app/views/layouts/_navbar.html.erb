<header class="d-flex flex-row justify-content-between navbar-header p-3">
  <div class="d-flex align-items-center">
    <%= image_tag "favicon.png", alt:"vendor booth", width:"40px", height:"40px" %> 
    <div class="d-flex flex-column ml-4">
      <h2 class="mb-0"><%= link_to "goVend", root_url, class:"nav-title" %></h2>
      <p class="subtitle mb-0 d-none d-md-block">Connecting Vendors and Events</p>
    </div>
  </div>

<div class="main-nav" id="mainNav">
  <div class="nav-links">
    <% if current_user.present? %>
        <%= link_to events_path, class: "nav-link-item" do %>
          <i class="fa fa-search d-md-none"></i>
          <span>Search</span>
        <% end %>
        
        <%= link_to vendor_events_path, class: "nav-link-item" do %>
          <i class="fa fa-calendar d-md-none"></i>
          <span>My Events</span>
        <% end %>
        
        <%= link_to user_path(current_user), class: "nav-link-item" do %>
          <i class="fa fa-user d-md-none"></i>
          <span>Profile</span>
        <% end %>
        
        <%= link_to new_event_path, class: "nav-link-item d-none d-md-flex" do %>
          <span>Host</span>
        <% end %>

        <%= link_to feed_path(current_user), class: "nav-link-item" do %>
          <i class="fa fa-rss d-md-none"></i>
          <span>Feed</span>
        <% end %>

        <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link-item d-none d-md-flex" do %>
          <span>Sign Out</span>
        <% end %>
      <% else %>
        <%= link_to root_path, class: "nav-link-item d-md-none" do %>
          <i class="fa fa-home"></i>
          <span>Home</span>
        <% end %>
        
        <%= link_to new_user_session_path, class: "nav-link-item" do %>
          <i class="fa fa-sign-in d-md-none"></i>
          <span>Sign In</span>
        <% end %>
        
        <%= link_to new_user_registration_path, class: "nav-link-item" do %>
          <i class="fa fa-user-plus d-md-none"></i>
          <span>Sign Up</span>
        <% end %>
    <% end %>
  </div>
</div>
</header>
